{
  "compilerOptions": {
    "target": "es2025",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2025",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ES7"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "src",
    "sourceMap": true,
    "paths":{
      "https://cdn.jsdelivr.net/npm/fuse.js@7.5.0/dist/fuse.mjs": [
        "./node_modules/fuse.js"
      ]
    }
  },
  
  "include": [
    "src/**/*",
    "cdn-modules.d.ts"
  ],
  "exclude":[
    "build/**/*"
  ]
}